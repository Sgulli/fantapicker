# --- Database ---
# Local Docker (no SSL). Host port 5433 — see docker-compose.yml.
# DATABASE_URL=postgres://fantapicker:fantapicker@localhost:5433/fantapicker

# Neon (preferred): `neon link` / `neon env pull` write these.
# Pooled runtime URL (-pooler). App + Vercel use DATABASE_URL.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct / unpooled — drizzle-kit migrations, dumps, session features.
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Alias used by drizzle.config.ts (same as DATABASE_URL_UNPOOLED).
DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=<branch>

# --- API (local listen only; ignored on Vercel) ---
PORT=3001
NODE_ENV=development

# --- Auth ---
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-output
# Public site origin (Vite proxy locally; HTTPS production URL on Vercel).
BETTER_AUTH_URL=http://localhost:5173
# CORS / cookies: production web URL. Defaults to BETTER_AUTH_URL if unset.
WEB_ORIGIN=http://localhost:5173

# --- Seed only (pnpm seed:admin). Do not use a weak password in production. ---
ADMIN_EMAIL=admin@fantapicker.local
ADMIN_PASSWORD=changeme-min-8-chars
